# Backend — SaaS Orchestrator

DATABASE_URL="postgresql://user:password@host:5432/saas_orchestrator"

# JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Bcrypt
BCRYPT_ROUNDS=12

# Server
PORT=8080
NODE_ENV=development

# Docker
DOCKER_NETWORK="saas_orchestrator_net"
DOCKER_BASE_IMAGE="node:20-alpine"
BUILD_DIR="/tmp/saas-builds"
TEMPLATES_DIR="/app/templates/base"
MODULES_DIR="/app/modules"

