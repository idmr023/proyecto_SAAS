generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  nombre         String
  totpSecret     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresas       MypeEmpresa[]
  auditoria      AuditLog[]
}

model Colaborador {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  nombre         String
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ticketsAsignados Ticket[] @relation("TicketAsignado")
}

model MypeEmpresa {
  id             String   @id @default(uuid())
  adminId        String
  nombre         String
  rubro          String
  subdominio     String   @unique
  estado         String   @default("activa")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  modulos        ConfiguracionModulos[]
  contenedores   ContenedorLog[]
  tickets        Ticket[]
}

model ConfiguracionModulos {
  id             String   @id @default(uuid())
  empresaId      String
  modulo         String
  activo         Boolean  @default(false)
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresa        MypeEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, modulo])
}

model ContenedorLog {
  id             String   @id @default(uuid())
  empresaId      String
  contenedorId   String?
  imagen         String
  puerto         Int?
  estado         String
  mensaje        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresa        MypeEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Ticket {
  id             String        @id @default(uuid())
  empresaId      String?
  cliente        String
  email          String?
  telefono       String?
  descripcion    String
  estado         String        @default("pendiente")
  asignadoAId    String?
  asignadoPor    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  empresa        MypeEmpresa?  @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  asignadoA      Colaborador?  @relation("TicketAsignado", fields: [asignadoAId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id             String   @id @default(uuid())
  adminId        String?
  accion         String
  entidad        String
  entidadId      String?
  detalle        String?
  ip             String?
  createdAt      DateTime @default(now())

  admin          Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
}

model LockoutAttempt {
  id             String   @id @default(uuid())
  identifier     String   @unique
  attempts       Int      @default(0)
  lockedUntil    DateTime?
  lastAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
}
